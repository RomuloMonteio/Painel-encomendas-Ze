rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.nivel == 'admin';
    }

    // Perfil do utilizador — o próprio lê o seu; admins leem/criam/atualizam qualquer um.
    // A conta de autenticação (login/password) é gerida à parte pelo Firebase Auth;
    // este documento só guarda nome/email/nível/estado ativo.
    match /users/{userId} {
      allow read:   if request.auth != null && (request.auth.uid == userId || isAdmin());
      allow create: if isAdmin();
      allow update: if isAdmin()
                    // um admin não se pode autodespromover nem autodesativar por engano
                    && !(request.auth.uid == userId && request.resource.data.nivel != resource.data.nivel)
                    && !(request.auth.uid == userId && request.resource.data.ativo == false);
      allow delete: if false; // "remover" é desativar (ativo:false); apagar de vez só via Firebase Console
    }

    // Encomendas — qualquer utilizador autenticado lê e actualiza estado
    match /encomendas/{encId} {
      allow read:   if request.auth != null;
      allow create: if request.auth != null
                    && request.resource.data.userId == request.auth.uid;
      allow update: if request.auth != null;
      allow delete: if false;
    }

    // Contagens de stock
    match /contagens/{cntId} {
      allow read:   if request.auth != null;
      allow create: if request.auth != null
                    && request.resource.data.userId == request.auth.uid;
      allow update: if request.auth != null;
      allow delete: if request.auth != null;
    }

    // Contador de números de encomenda (meta/counter)
    match /meta/{docId} {
      allow read, write: if request.auth != null;
    }

    // Lista de Faltas — ciclo semanal (id determinístico = data da terça-limite)
    match /listasFalta/{cicloId} {
      allow read:            if request.auth != null;
      allow create, update:  if request.auth != null;
      allow delete:           if false;

      match /itens/{itemId} {
        allow read:   if request.auth != null;
        allow create: if request.auth != null
                      && request.resource.data.adicionadoPor == request.auth.uid;
        allow update, delete: if request.auth != null;
      }
    }

    // Catálogo de nomes já usados na Lista de Faltas (autocomplete)
    match /faltasCatalogo/{itemSlug} {
      allow read, write: if request.auth != null;
    }
  }
}
