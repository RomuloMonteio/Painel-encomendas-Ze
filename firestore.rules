rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Perfil do utilizador — apenas o próprio pode ler
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if false; // Criar via Firebase Console ou script de admin
    }

    // Encomendas — qualquer utilizador autenticado lê e actualiza estado
    match /encomendas/{encId} {
      allow read:   if request.auth != null;
      allow create: if request.auth != null
                    && request.resource.data.userId == request.auth.uid;
      allow update: if request.auth != null;
      allow delete: if false;
    }

    // Contagens de stock
    match /contagens/{cntId} {
      allow read:   if request.auth != null;
      allow create: if request.auth != null
                    && request.resource.data.userId == request.auth.uid;
      allow update: if request.auth != null;
      allow delete: if request.auth != null;
    }

    // Contador de números de encomenda (meta/counter)
    match /meta/{docId} {
      allow read, write: if request.auth != null;
    }

    // Lista de Faltas — ciclo semanal (id determinístico = data da terça-limite)
    match /listasFalta/{cicloId} {
      allow read:            if request.auth != null;
      allow create, update:  if request.auth != null;
      allow delete:           if false;

      match /itens/{itemId} {
        allow read:   if request.auth != null;
        allow create: if request.auth != null
                      && request.resource.data.adicionadoPor == request.auth.uid;
        allow update, delete: if request.auth != null;
      }
    }

    // Catálogo de nomes já usados na Lista de Faltas (autocomplete)
    match /faltasCatalogo/{itemSlug} {
      allow read, write: if request.auth != null;
    }
  }
}
